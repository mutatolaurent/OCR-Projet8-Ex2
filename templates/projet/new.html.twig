{% extends 'base.html.twig' %}

{% block title %}Détails du projet - TaskLinker{% endblock %}

{% block body %}
<main>
<header>
    {{ include('_avatar.html.twig') }}
    <div id="title-page">
        <h1>{% if isEdit %}
                Modifier le projet
            {% else %}
                Nouveau projet
            {% endif %}
        </h1>
    </div>
</header>
<div id="content">
    <div>{{ form_errors(form) }}</div>
    {{ form_start(form) }}
        <div>
            {{ form_row(form.nom, {label: 'Titre du projet'}) }}
        </div>
        <div>
            {{ form_row(form.employes, {
                'label': 'Employés assignés',
                'attr': { 'data-controller': 'select' }
                }) 
            }}
        </div>
        <br>
        {{ form_rest(form) }}
        <button class="button button-submit">Continuer</button>
    {{ form_end(form) }}
</div>
</main>
{% endblock %}