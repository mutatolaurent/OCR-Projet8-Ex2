{% extends 'base-logout.html.twig' %}

{% block title %}Formulaire d'inscription{% endblock %}

{% block body %}
<main class="logout-main">
    <div class="register-box">
        <h1>S'inscrire</h1>
        {{ form_start(form) }}
            <div>{{ form_row(form.nom, {label: 'Nom'}) }}</div>
            <div>{{ form_row(form.prenom, {label: 'Prenom'}) }}</div>
            <div>{{ form_row(form.email, {label: 'Email'}) }}</div>
            <div>{{ form_row(form.password, {label: 'Mot de passe'}) }}</div>
            <button class="button button-1 button-1-margintop">Continuer</button>
        {{ form_end(form) }}
        <a href="{{ path('app_login') }}">Vous avez déjà un compte ?</a>   
    </div>
</main>

{% endblock %}